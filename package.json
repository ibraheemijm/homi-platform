{
  "name": "@homi/platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply homi-platform --local",
    "db:migrate:remote": "wrangler d1 migrations apply homi-platform --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261121.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "wrangler": "^4.48.0"
  }
}
